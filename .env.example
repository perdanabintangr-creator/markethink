# =====================================================================
# Markethink — environment variables
# Copy ke .env.local untuk development lokal. JANGAN commit file .env*.
# Variabel NEXT_PUBLIC_* terekspos ke browser — jangan taruh secret di sana.
# =====================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Email yang otomatis jadi admin saat pertama login (pisahkan dengan koma)
ADMIN_EMAILS=

# --- Supabase (Auth, Postgres, Storage, pgvector) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Isi "true" setelah Google OAuth diaktifkan di Supabase (Authentication → Providers → Google)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
SUPABASE_SERVICE_ROLE_KEY=
# Untuk menjalankan migrasi via Supabase CLI (hanya dipakai saat dev/CI)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- LLM providers (server-only) ---
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# --- Web search ---
TAVILY_API_KEY=

# --- Rate limit & kuota ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="Markethink <onboarding@resend.dev>"

# --- Analytics & error tracking ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Model router (opsional) ---
# Ganti model per tier tanpa ubah kode. Format: provider:model_id,provider:model_id (primary -> fallback)
# Provider: google | groq | openrouter. Kosongkan untuk memakai default di src/lib/ai/models.config.ts
MODEL_JUNIOR=
MODEL_SENIOR=
MODEL_ASSOCIATE=
EMBEDDING_MODEL=gemini-embedding-001
